{
    "showIntro": false,
    "messageTemplate": "@type(@scope): @message",
    "commitTitleCharLimit": 50,
    "commitBodyLineLength": 72,

    "prefixes": [
        { "type": "feat",     "description": "Adding new feature/function/option" },
        { "type": "fix",      "description": "Correcting malfunction" },
        { "type": "chore",    "description": "Other changes that don't modify src or test files" },
        { "type": "style",    "description": "Formatting, whitespace, indentation" },
        { "type": "ci",       "description": "Continuous integration/deployment" },
        { "type": "docs",     "description": "Documentation and comments" },
        { "type": "refactor", "description": "Purely structural" },
        { "type": "perf",     "description": "Performance improvement" },
        { "type": "build",    "description": "Compilation, tools and dependency" },
        { "type": "test",     "description": "Adding missing tests or correcting existing tests"},
        { "type": "revert",   "description": "Rewind time, rollback" }
    ],
    "allowCustomPrefixes": false,

    "scopes": [
    ],
    "allowCustomScopes": false
}
